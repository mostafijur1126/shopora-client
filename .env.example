VITE_API_URL="http://localhost:5000/api"
# VITE_API_URL="https://shopora-server.vercel.app"


//* For Backend only

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=

PORT=

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=

# JWT secret — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=

# Optional: used to seed the first admin account (see src/scripts/seedAdmin.ts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary image, video, and payment screenshot uploads
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
